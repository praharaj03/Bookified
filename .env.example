# Application
# Vapi requires a public HTTPS deployment or development tunnel for book search.
NEXT_PUBLIC_BASE_URL=

# Authentication - Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Database - MongoDB (the app uses the bookified database)
MONGODB_URI=

# File storage - Vercel Blob (public store)
BLOB_READ_WRITE_TOKEN=

# AI summaries and questions - Gemini
GOOGLE_GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Voice conversations - Vapi
NEXT_PUBLIC_VAPI_API_KEY=
NEXT_PUBLIC_ASSISTANT_ID=
VAPI_PRIVATE_API_KEY=
# Optional separate signing secret. Falls back to CLERK_SECRET_KEY.
VAPI_WEBHOOK_SECRET=

# Natural narration - ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_v4
